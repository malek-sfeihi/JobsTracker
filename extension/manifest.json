{
  "manifest_version": 3,
  "name": "JobsTracker",
  "version": "1.0",
  "description": "Adds a JobsTracker button to Gmail that opens your applications dashboard.",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open JobsTracker",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
